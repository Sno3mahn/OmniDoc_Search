# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real secret here.

# DeepSeek API key. Required - used for answer synthesis, and for the fallback
# extraction agent on sites where neither sitemap nor nav parsing finds pages.
API_DEEPSEEK=

# This server's own shared key, sent by clients as the X-API-Key header.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
# Hex rather than base64 so it is also a legal WebSocket subprotocol token -
# browsers cannot set headers on a WebSocket, so the key rides there instead.
API_KEY=

# --- optional, all have working defaults (see RUNNING.md) -------------------
# RAG_TOP_K=8
# RAG_CHUNK_SIZE=256
# QUERY_CACHE=1
# CORPUS_TTL_SECONDS=1209600
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
